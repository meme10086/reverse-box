class_name LevelManager
extends Node2D
## 关卡数据与静态地块的唯一持有者。
## 职责：把文本布局解析成网格、用 _draw 画出地板/墙/目标点、维护「哪一格上有箱子」。
## 坐标约定：cell.x = 列（向右增大），cell.y = 行（向下增大，即布局数组的行号）。
## 本类不做任何移动规则判断；移动规则在 GameManager.try_move_player()。
## 关卡均为文本数组，8 关全部经 BFS 验证可解，且刻意做得"开放"（同一关有多种解法）。

enum Tile { FLOOR, WALL }

const CELL := 48.0          # 每格世界像素
const MARGIN := 2.0         # 地块间留缝，避免糊成一片

const COLOR_FLOOR := Color(0.15, 0.16, 0.21)
const COLOR_WALL := Color(0.40, 0.43, 0.54)
const COLOR_GOAL := Color(0.95, 0.78, 0.25)

const TEX_DIR := "res://assets/art/pixel/"
const TILE_GAP := 1.0       # 地块之间留 1px 缝，避免糊成一片

var _tex_floor: Texture2D
var _tex_wall: Texture2D
var _tex_goal: Texture2D
var _tiles_loaded := false

# 关卡文本符号（与策划文档一致）
const CH_WALL := "#"
const CH_FLOOR := "."
const CH_GOAL := "*"
const CH_PLAYER := "@"
const CH_BOX := "$"
const CH_BOX_ON_GOAL := "&"
const CH_PLAYER_ON_GOAL := "+"

# 10 个关卡，按「一关一个台阶」排布。每关两个回溯参数：
#   rewind_budget —— 可用的回溯次数（玩家回溯 1 次 / 箱子回溯 1 次各消耗 1）。
#   par_rewinds  —— 设计上的最优回溯次数，用于 S/A/B/C 评级。
#
# 难度阶梯（全部经 Python 参考模拟器验证）：
#   第 1 关      纯推箱教学，不需要回溯（唯一允许不用时间机制的关）。
#   第 2 关起    每一关都必须花掉**两次**回溯，其中一部分关卡还要求
#               "玩家回溯"和"箱子回溯"两种都用上 —— 只回溯箱子过不去。
#   地图保持小（9x5 ~ 10x7），难度来自"要想通哪一步用哪种回溯"，
#   而不是地图变大或步数变长。
#
# 所有布局要求：每行等宽、边框全为墙、恰好 1 个玩家、箱子数 == 目标点数。
# 设计红线：除第 1 关外，每一关都**不用时间机制则无解**，且**只给一次回溯也无解**
#          （已用搜索逐关验证：预算 1 找不到解，预算 2 才有解）。
