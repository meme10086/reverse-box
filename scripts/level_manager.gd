# 每关的「目标步数」（= 设计上的最优解动作数），用于三星评价的第三颗星。
# 故意单独放一张表：LEVELS 的文本保持逐字不动（第 1~15 关一行都不改）。
const PAR_STEPS: Array = [6,7,8,8,11,11,12,13,13,13,7,8,9,11,11,31,37,42,48,53,77,91,100,114,115,123,124,134,148,154]


# 该关的目标步数（0 = 不设目标）
static func level_par_steps(index: int) -> int:
	if index < 0 or index >= PAR_STEPS.size():
		return 0
	return PAR_STEPS[index]

var current_index := 0
var grid: Array = []                # Array[Array]，内层元素为 Tile 枚举
var goals: Array = []               # Array[Vector2i]
var boxes: Dictionary = {}          # cell(Vector2i) -> Box
var box_cells: Array = []           # 初始箱子格 Array[Vector2i]
var player_start := Vector2i.ZERO

var width := 0
var height := 0

# ---- 多地图（大关 3） ----
# rooms[i] = {grid, goals, goal_colors, width, height, portals}
# 单地图关卡只有 rooms[0]，一切走老路径；多地图关卡由 build() 按 "rooms" 字段建立。
var rooms: Array = []
var room_index := 0
var goal_colors: Dictionary = {}      # cell -> 颜色编号（0 = 无色）
var box_specs: Array = []             # [{room, cell, color}]（行优先顺序 = 箱号顺序）
var portal_pairs: Array = []          # [[roomA, cellA, roomB, cellB], ...]
## 分层提示的高亮格子：room_index -> {cell -> Color}。按 H 由 game.gd 填入。
var hint_cells: Dictionary = {}


static func level_count() -> int:
	return LEVELS.size()


static func level_name(index: int) -> String:
	if index < 0 or index >= LEVELS.size():
		return "?"
	return LEVELS[index]["name"]


# 该关可用的回溯次数（玩家回溯 1 次、箱子回溯 1 次，各消耗 1）
static func level_rewind_budget(index: int) -> int:
	if index < 0 or index >= LEVELS.size():
		return 0
	return LEVELS[index].get("rewind_budget", 3)


# 设计上的最优回溯次数（评级基准）
static func level_par_rewinds(index: int) -> int:
	if index < 0 or index >= LEVELS.size():
		return 0
	return LEVELS[index].get("par_rewinds", 1)


# 该关有几张地图（单地图关卡 = 1）
static func level_room_count(index: int) -> int:
	if index < 0 or index >= LEVELS.size():
		return 1
	var d: Dictionary = LEVELS[index]
	if d.has("rooms"):
		return maxi(1, (d["rooms"] as Array).size())
	return 1


# 该关的新手提示（教学关才有；空串表示不显示）
static func level_hint(index: int) -> String:
	if index < 0 or index >= LEVELS.size():
		return ""
	return LEVELS[index].get("hint", "")


# 回溯距离上限（单位：步）。0 = 不限（第一大关），>0 = 只能回到不超过这么多步之前（第二大关）
static func level_rewind_span(index: int) -> int:
	if index < 0 or index >= LEVELS.size():
		return 0
	return LEVELS[index].get("rewind_span", 0)


# 引导步骤（第一条教学关用）：数组元素形如 {"tip": 文案, "done": 触发条件}
static func level_guide(index: int) -> Array:
	if index < 0 or index >= LEVELS.size():
		return []
	return LEVELS[index].get("guide", [])


func _ready() -> void:
	_load_tiles()


func _load_tiles() -> void:
	if _tiles_loaded:
		return
	_tiles_loaded = true
	_tex_floor = load(TEX_DIR + "tiles/floor.png")
	_tex_wall = load(TEX_DIR + "tiles/wall.png")
	_tex_goal = load(TEX_DIR + "tiles/goal.png")


func build(index: int = 0, data_override: Dictionary = {}) -> void:
	current_index = index
	rooms.clear()
	box_specs.clear()
	boxes.clear()
	box_cells.clear()
	goal_colors.clear()
	player_start = Vector2i.ZERO
	room_index = 0

	var data: Dictionary = data_override
	if data.is_empty():
		data = LEVELS[index] if index >= 0 and index < LEVELS.size() else LEVELS[0]
	var layouts: Array = data["rooms"] if data.has("rooms") else [data["layout"]]

	var letters: Dictionary = {}      # 传送门字母 -> [[room, cell], ...]
	for i in layouts.size():
		var r := _parse_room(layouts[i])
		rooms.append(r)
		if i == 0:
			player_start = r["player"]
		for b in r["boxes"]:
			box_specs.append({"room": i, "cell": b["cell"], "color": b["color"]})
			if i == 0:
				box_cells.append(b["cell"])
		for cell in (r["portals"] as Dictionary):
			var ch: String = r["portals"][cell]
			if not letters.has(ch):
				letters[ch] = []
			letters[ch].append([i, cell])

	portal_pairs.clear()
	for ch in letters:
		var pair: Array = letters[ch]
		if pair.size() == 2:
			portal_pairs.append([pair[0][0], pair[0][1], pair[1][0], pair[1][1]])

	_apply_room(0)


# 解析一张地图的布局（支持颜色地砖 1/2/3、颜色箱子 a/b/c、传送门 A/B/C）
func _parse_room(layout: Array) -> Dictionary:
	var g: Array = []
	var gs: Array = []
	var gc: Dictionary = {}
	var bx: Array = []
	var ps := Vector2i.ZERO
	var portals: Dictionary = {}

	var h: int = layout.size()
	var w := 0
	for line in layout:
		w = maxi(w, String(line).length())

	for y in h:
		var row: Array = []
		var line2: String = String(layout[y])
		for x in w:
			var ch: String = line2[x] if x < line2.length() else CH_FLOOR
			var cell := Vector2i(x, y)
			row.append(Tile.WALL if ch == CH_WALL else Tile.FLOOR)
			if ch == CH_WALL:
				continue
			if ch == CH_GOAL or ch == CH_BOX_ON_GOAL or ch == CH_PLAYER_ON_GOAL:
				gs.append(cell)
				gc[cell] = 0
			elif ch == "1" or ch == "2" or ch == "3":
				gs.append(cell)
				gc[cell] = int(ch)
			if ch == CH_BOX or ch == CH_BOX_ON_GOAL:
				bx.append({"cell": cell, "color": 0})
			elif ch == "a" or ch == "b" or ch == "c":
				bx.append({"cell": cell, "color": "abc".find(ch) + 1})
			if ch == CH_PLAYER or ch == CH_PLAYER_ON_GOAL:
				ps = cell
			if ch == "A" or ch == "B" or ch == "C" or ch == "D":
				portals[cell] = ch
		g.append(row)

	return {"grid": g, "goals": gs, "goal_colors": gc, "boxes": bx,
			"player": ps, "width": w, "height": h, "portals": portals}


# 切到第 i 张地图（把该图的数据投影到 grid/goals/width/height 上，老代码继续可用）
func set_room(i: int) -> void:
	_apply_room(clampi(i, 0, room_count() - 1))


func _apply_room(i: int) -> void:
	if rooms.is_empty():
		return
	room_index = i
	var r: Dictionary = rooms[i]
	grid = r["grid"]
	goals = r["goals"]
	goal_colors = r["goal_colors"]
	width = r["width"]
	height = r["height"]
	queue_redraw()


func room_count() -> int:
	return maxi(1, rooms.size())


func current_room() -> int:
	return room_index


# 该格是不是传送门：返回 [目标地图, 目标格]，不是门就返回 []
func portal_at(room: int, cell: Vector2i) -> Array:
	if room < 0 or room >= rooms.size():
		return []
	for pair in portal_pairs:
		if pair[0] == room and pair[1] == cell:
			return [pair[2], pair[3]]
		if pair[2] == room and pair[3] == cell:
			return [pair[0], pair[1]]
	return []


# 该格上的传送门字母（绘制用）；不是门返回 ""
func portal_char_at(room: int, cell: Vector2i) -> String:
	if room < 0 or room >= rooms.size():
		return ""
	var p: Dictionary = rooms[room]["portals"]
	return String(p[cell]) if p.has(cell) else ""


# ---------------- 分层提示 ----------------

# 某张地图上所有传送门所在的格子
func portal_cells_in(room: int) -> Array:
	if room < 0 or room >= rooms.size():
		return []
	return (rooms[room]["portals"] as Dictionary).keys()


# 高亮一组格子（在该图显示一圈描边 + 中心点）
func set_hint_cells(room: int, cells: Array, col: Color) -> void:
	var d := {}
	for c in cells:
		d[c] = col
	hint_cells[room] = d
	queue_redraw()


func clear_hints() -> void:
	hint_cells.clear()
	queue_redraw()


# ---------------- 查询 ----------------

func cell_to_world(cell: Vector2i) -> Vector2:
	var hw := (width - 1) * 0.5
	var hh := (height - 1) * 0.5
	return Vector2((cell.x - hw) * CELL, (cell.y - hh) * CELL)


func in_bounds(cell: Vector2i) -> bool:
	return in_bounds_in(room_index, cell)


func in_bounds_in(room: int, cell: Vector2i) -> bool:
	if room < 0 or room >= rooms.size():
		return false
	var r: Dictionary = rooms[room]
	return cell.x >= 0 and cell.y >= 0 and cell.x < r["width"] and cell.y < r["height"]


func is_walkable(cell: Vector2i) -> bool:
	return is_walkable_in(room_index, cell)


func is_walkable_in(room: int, cell: Vector2i) -> bool:
	if not in_bounds_in(room, cell):
		return false
	return rooms[room]["grid"][cell.y][cell.x] != Tile.WALL


func is_goal(cell: Vector2i) -> bool:
	return goals.has(cell)


# 该格是不是"这只箱子能用的目标点"（颜色要对上）
func is_goal_for(room: int, cell: Vector2i, color: int) -> bool:
	if room < 0 or room >= rooms.size():
		return false
	var gc: Dictionary = rooms[room]["goal_colors"]
	return gc.has(cell) and int(gc[cell]) == color


func get_box_at(cell: Vector2i):
	return get_box_at_in(room_index, cell)


func get_box_at_in(room: int, cell: Vector2i):
	return boxes.get(Vector3i(room, cell.x, cell.y))


func goal_count() -> int:
	return goals.size()


# 整个关卡（所有地图）的目标点总数 —— 多地图关卡的通关判定要用这个
func total_goal_count() -> int:
	var n := 0
	for r in rooms:
		n += (r["goals"] as Array).size()
	return n if not rooms.is_empty() else goals.size()


# 箱子占位登记：把 key 从 from 挪到 to
func move_box_record(from: Vector2i, to: Vector2i, room := -1) -> void:
	var r: int = room_index if room < 0 else room
	var k := Vector3i(r, from.x, from.y)
	if boxes.has(k):
		var b = boxes[k]
		boxes.erase(k)
		boxes[Vector3i(r, to.x, to.y)] = b


func register_box(box) -> void:
	var r: int = box.room if "room" in box else 0
	boxes[Vector3i(r, box.cell.x, box.cell.y)] = box


# 时间回溯回放时先清空占位表，再由 GameManager 按新位置重新登记
func clear_box_registry() -> void:
	boxes.clear()


# ---------------- 绘制（静态地块） ----------------

func _draw() -> void:
	if grid.is_empty():
		return
	if not _tiles_loaded:
		_load_tiles()
	for y in height:
		for x in width:
			var cell := Vector2i(x, y)
			var center := cell_to_world(cell)
			var rect := Rect2(center - Vector2(CELL * 0.5, CELL * 0.5),
					Vector2(CELL, CELL)).grow(-TILE_GAP)

			if grid[y][x] == Tile.WALL:
				_draw_tile(_tex_wall, rect, COLOR_WALL)
			elif is_goal(cell):
				_draw_tile(_tex_goal, rect, tile_color_of(cell))
				# 颜色地砖：叠一圈同色描边 + 中心圆点，否则贴图乘色后看不出是哪种颜色
				if int(goal_colors.get(cell, 0)) != 0:
					var col := tile_color_of(cell)
					draw_rect(rect.grow(-CELL * 0.14), col, false, 4.0)
					draw_circle(center, CELL * 0.14, col)
			else:
				_draw_tile(_tex_floor, rect, COLOR_FLOOR)

			# 传送门：画在地块之上（像素风圆环 + 中心点）
			var pch := portal_char_at(room_index, cell)
			if pch != "":
				_draw_portal(center, pch)

			# 分层提示的高亮格：一圈亮描边 + 中心点
			var hd: Dictionary = hint_cells.get(room_index, {})
			if hd.has(cell):
				var hcol: Color = hd[cell]
				draw_rect(rect.grow(-TILE_GAP * 1.6), hcol, false, 3.0)
				draw_circle(center, CELL * 0.11, hcol)


# 色盲友好：用**形状**区分颜色（1 紫=三角 / 2 黄=圆 / 3 绿=方）。
# 纯颜色约有 8% 男性分不出，加一层形状就稳了。
static func draw_color_mark(ci: CanvasItem, kind: int, center: Vector2,
		r: float, col: Color) -> void:
	match kind:
		1:
			ci.draw_colored_polygon(PackedVector2Array([
				center + Vector2(0.0, -r),
				center + Vector2(r * 0.95, r * 0.70),
				center + Vector2(-r * 0.95, r * 0.70),
			]), col)
		3:
			ci.draw_rect(Rect2(center - Vector2(r * 0.72, r * 0.72),
				Vector2(r * 1.44, r * 1.44)), col)
		_:
			ci.draw_circle(center, r * 0.85, col)


# 地砖颜色：无色目标点 = 金色；1/2/3 = 紫 / 橙黄 / 绿（与 box.gd 的箱子颜色保持一致）
func tile_color_of(cell: Vector2i) -> Color:
	var c: int = int(goal_colors.get(cell, 0))
	match c:
		1:
			return Color(0.72, 0.45, 1.00)      # 紫
		2:
			return Color(1.00, 0.78, 0.20)      # 橙黄
		3:
			return Color(0.35, 0.95, 0.50)      # 绿
		_:
			return COLOR_GOAL


const PORTAL_COLORS := {
	"A": Color(0.35, 0.85, 1.00),      # 青
	"B": Color(1.00, 0.42, 0.85),      # 品红
	"C": Color(1.00, 0.68, 0.28),      # 琥珀
	"D": Color(0.62, 0.95, 0.45),      # 黄绿
}


func portal_color_of(ch: String) -> Color:
	return PORTAL_COLORS.get(ch, Color(0.35, 0.85, 1.00))


# 传送门：虚线圆环 + 中心亮点（不依赖任何新素材）
func _draw_portal(center: Vector2, ch: String) -> void:
	var col := portal_color_of(ch)
	var r := CELL * 0.30
	var seg := 10
	for i in seg:
		if i % 2 == 1:
			continue
		var a0 := TAU * float(i) / float(seg)
		var a1 := TAU * float(i + 1) / float(seg)
		draw_line(center + Vector2(cos(a0), sin(a0)) * r,
				center + Vector2(cos(a1), sin(a1)) * r, col, 3.0, true)
	draw_circle(center, r * 0.30, col)


# 有贴图就画像素地砖；贴图缺失时退回纯色块（保证没素材也能跑）
func _draw_tile(tex: Texture2D, rect: Rect2, fallback: Color,
		tint := Color(1, 1, 1)) -> void:
	if tex != null:
		draw_texture_rect(tex, rect, false, tint)
	else:
		draw_rect(rect, fallback)
